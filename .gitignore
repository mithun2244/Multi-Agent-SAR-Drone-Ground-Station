# --- secrets -----------------------------------------------------------
# NVIDIA_API_KEY, REDIS_URL and anything else that authenticates us.
.env
.env.*
!.env.example
*.key
*.pem

# --- virtual environments ----------------------------------------------
.venv/
venv/
env/
ENV/

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# --- test and type caches ----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# --- raw data and logs -------------------------------------------------
# Recorded RGB/LiDAR footage, telemetry, DEM tiles and bus dumps. These are
# large, often personally identifying, and never belong in the repository.
#
# data/ holds the scripts that fetch and prepare all of it, so it is an
# allow-list rather than a blanket ignore: the scripts and their docs are
# tracked, everything they download or generate is not. The `data/**/` line is
# required — git will not re-include a file whose parent directory is excluded.
data/**
!data/**/
!data/**/*.py
!data/**/*.sh
!data/**/*.md
!data/**/.gitkeep

# Spelled out as well, because these are the ones that would hurt: two gigabytes
# of VisDrone, a range image per LiDAR sweep, or a 40 MB checkpoint.
data/**/*.pt
data/**/*.jpg
data/**/*.jpeg
data/**/*.png

# Trained weights. config/weights/ is committed empty; what goes in it is not —
# a checkpoint worth keeping belongs in a release.
config/weights/*
!config/weights/.gitkeep

raw/
recordings/
footage/
dem_tiles/
logs/
*.log
*.jsonl
*.mcap
*.bag
*.rdb          # Redis dumps
*.tif
*.tiff

# --- local configuration overrides -------------------------------------
# config/tuned_params.json IS committed: it is the result of a tuning run and
# the README quotes it. Machine-specific overrides are not.
config/*.local.json
config/local/
*.local.json
settings.local.json
.claude/settings.local.json

# --- optimisation artefacts --------------------------------------------
optuna*.db
*.sqlite3
studies/

# --- generated output ---------------------------------------------------
# coordinator/map_visualizer.py writes this; the script is the source, the
# map is a render of wherever it last pointed.
sar_target_map.html

# --- training artefacts -------------------------------------------------
# train_perception.py writes runs/ (weights, plots, per-epoch results) and
# ultralytics downloads datasets/ alongside the repo. Gigabytes of derived
# output; weights that are worth keeping belong in a release, not in git.
runs/
datasets/
*.pt

# --- editors and operating systems --------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
